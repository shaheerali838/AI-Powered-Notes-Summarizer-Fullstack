    "firebase-functions": "^5.0.0",
    "mammoth": "^1.7.2",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.2",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
